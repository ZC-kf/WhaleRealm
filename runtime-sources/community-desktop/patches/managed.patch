+/// 用每实例 token 交换权威绑定的会话 cookie（核心 `authorizeIndex` 的 303 + `Set-Cookie`）。
+pub(crate) async fn carrier_cookie(port: u16) -> Option<String> {
+    let token = carrier_token(port)?;
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .timeout(Duration::from_secs(8))
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .ok()?;
+    let root = format!("{}/", crate::config::get_dsh_service_url(port));
+    let response = client
+        .get(&root)
+        .query(&[("token", token.as_str())])
+        .send()
+        .await
+        .ok()?;
+    response
+        .headers()
+        .get(reqwest::header::SET_COOKIE)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.split(';').next())
+        .map(str::to_string)
