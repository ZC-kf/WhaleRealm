+/// 解析核心启动时打印的认证 URL 行，取出 `(port, token)`。
+///
+/// 形如 `dsh web: http://127.0.0.1:23851/?token=<token>`，可能尾随
+/// ` (LAN: http://<lan>:<port>/?token=<token>)`；只接受回环主机。
+pub(super) fn parse_launch_token(line: &str) -> Option<(u16, String)> {
+    const MARKER: &str = "dsh web: ";
+    let start = line.find(MARKER)? + MARKER.len();
+    let candidate = line[start..].split_whitespace().next()?;
+    let url = reqwest::Url::parse(candidate).ok()?;
+    let host = url.host_str()?;
+    if host != "127.0.0.1" && host != "localhost" {
+        return None;
+    }
+    let port = url.port()?;
+    let token = url
+        .query_pairs()
+        .find(|(key, _)| key == "token")
+        .map(|(_, value)| value.into_owned())?;
+    if token.is_empty() {
+        return None;
+    }
+    Some((port, token))
