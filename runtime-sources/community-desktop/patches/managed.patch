+//! browser-auth 载体补丁：让管理实例的本地桌面载体无需启动 token 即可访问内置 Web。
+//!
+//! 背景：dsh 核心自带启动鉴权以来，`dsh --profile web` 把 SPA 门禁在「每进程随机
+//! 启动 token」之后——`GET /` 无有效 token / cookie 一律 401
+//! （`@deepseek-ai/dsh-client-connection` 的 `BrowserAuth`）。社区桌面的设计是
+//! 「alpha 鉴权由启动前的桌面端 patch 处理，iframe 永远不携带启动 token」
+//! （见 `src/store/modules/harness/utils.ts`）：内嵌 iframe 用的是干净的
+//! `http://127.0.0.1:<port>?t=…&dshDesktop=1`，从不带上 token；同时
+//! `is_dsh_running` 的就绪探测也是无 token 的 `GET /`（要求 200）。
+//!
+//! 上游随桌面端发行的核心版本比本补丁集新，连接层新增了上述启动 token，而桌面端
+//! 补丁集尚未覆盖它，于是：`GET /` 恒为 401 → 就绪探测永不通过 → 状态到不了
+//! Running（也就不会落就绪文件），且内嵌 GUI 会显示鉴权提示。本补丁补齐上游缺失
+//! 的「桌面端鉴权补丁」：把 `BrowserAuth.isAuthenticated` 判定改成恒真，等价于
+//! 「本地载体已被信任」。
+//!
+//! 信任边界：Harness 只绑定 `127.0.0.1`，且 `/api` 另有 Origin/Referer 浏览器信任
+//! 围栏（`--trusted-host`）拦截跨站请求；本补丁只取消「每进程启动 token」这一层，
+//! 面向的是本机单用户隔离实例（自有端口、自有核心副本、自有 Electron user-data），
+//! 与随包上游桌面端对其内嵌载体的既定处置一致。
+//!
+//! 目标选择：**活动核心**（本地核心或预打包核心），读写与幂等判定统一交给
+//! [`crate::utils::patch_dsh`]；本模块只提供纯函数式补丁判定 [`patch_source`]。
+//!
+//! 幂等与容错：目标已含标记即跳过；文件缺失或锚点因上游布局变更找不到 → 跳过并
+//! 告警，不阻断启动。挂点：`service::workflow::launch` 启动 dsh 进程前，与其余
+//! 核心补丁同一位置（最佳努力，失败只告警）。
+
+use std::path::Path;
+
+use crate::utils::{patch_core_file, patch_dsh, PatchOutcome};
+
+/// 幂等标记：注入语句里带注释，重跑时直接命中「已打过」。
+const MARKER: &str = "WhaleRealm managed carrier: trust local desktop requests";
+
+/// `BrowserAuth.isAuthenticated` 方法定义锚点（带方法名与形参，避免命中调用点）。
+const ANCHOR: &str = "isAuthenticated(request) {";
+
+/// 相对活动核心安装目录的 dsh-client-connection 包内路径。
+const CONNECTION_INDEX_JS: &str =
+    "node_modules/@deepseek-ai/dsh-client-connection/lib/index.js";
+
+/// 幂等补丁逻辑的纯函数部分（便于单测，不触碰文件系统）。
+///
+/// 在 `isAuthenticated(request) {` 之后插入 `return true;`，按锚点所在行的**实际
+/// 前导缩进**再进一级，避免上游产物缩进（tab/空格）变化时插出坏行。
+fn patch_source(source: &str) -> PatchOutcome {
+    if source.contains(MARKER) {
+        return PatchOutcome::AlreadyPatched;
+    }
+    let Some(position) = source.find(ANCHOR) else {
+        return PatchOutcome::AnchorMissing;
+    };
+    let after = position + ANCHOR.len();
+    let line_start = source[..position]
+        .rfind('\n')
+        .map(|index| index + 1)
+        .unwrap_or(0);
+    let indent: String = source[line_start..position]
+        .chars()
+        .take_while(|character| *character == '\t' || *character == ' ')
+        .collect();
+    let body_indent = format!("{indent}\t");
+    let mut patched = source.to_string();
+    patched.insert_str(
+        after,
+        &format!("\n{body_indent}/* {MARKER} */\n{body_indent}return true;"),
+    );
+    PatchOutcome::Patched(patched)
+}
+
+/// 对活动核心的 dsh-client-connection `lib/index.js` 应用补丁（幂等）。
+/// 返回 Err 表示读/写失败；文件缺失、已打过、锚点变更均静默跳过（Ok）。
+pub fn apply(app_handle: &tauri::AppHandle) -> Result<(), String> {
+    patch_dsh(app_handle, CONNECTION_INDEX_JS, patch_source)
+}
+
+/// 对显式给定的核心安装目录施加本补丁（E2E 编排复用，无需运行中的桌面端）。
+pub fn apply_at(core_dir: &Path) -> Result<(), String> {
+    patch_core_file(core_dir, CONNECTION_INDEX_JS, patch_source)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 上游打包产物里该类方法的最小上下文（单 tab 缩进）。
+    const SOURCE: &str = "\t/** verify */\n\tisAuthenticated(request) {\n\t\tconst authority = requestAuthority(request.headers);\n\t\treturn true;\n\t}\n";
+
+    #[test]
+    fn inserts_return_true_after_anchor() {
+        match patch_source(SOURCE) {
+            PatchOutcome::Patched(patched) => {
+                assert!(patched.contains(MARKER));
+                assert!(patched.contains(
+                    "isAuthenticated(request) {\n\t\t/* WhaleRealm managed carrier: trust local desktop requests */\n\t\treturn true;\n\t\tconst authority"
+                ));
+            }
+            other => panic!("expected Patched, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn matches_double_tab_indentation() {
+        let double_tab = "\t\tisAuthenticated(request) {\n\t\t\tconst authority = 0;\n";
+        match patch_source(double_tab) {
+            PatchOutcome::Patched(patched) => {
+                // 插入体与锚点行对齐后再进一级（双 tab → 三 tab）
+                assert!(patched.contains(
+                    "isAuthenticated(request) {\n\t\t\t/* WhaleRealm managed carrier: trust local desktop requests */\n\t\t\treturn true;"
+                ));
+                assert!(!patched.contains("\n\t\treturn true;"));
+            }
+            other => panic!("expected Patched, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn is_idempotent() {
+        let PatchOutcome::Patched(patched) = patch_source(SOURCE) else {
+            panic!("expected Patched");
+        };
+        assert_eq!(patch_source(&patched), PatchOutcome::AlreadyPatched);
+    }
+
+    #[test]
+    fn skips_when_anchor_missing() {
+        let altered = "isAuthenticated(request, extra) {\n\treturn false;\n}\n";
+        assert_eq!(patch_source(altered), PatchOutcome::AnchorMissing);
+    }
+}
