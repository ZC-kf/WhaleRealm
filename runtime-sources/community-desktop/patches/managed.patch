+// WhaleRealm Copyright (C) 2026 凛枫. SPDX-License-Identifier: GPL-3.0-or-later
+use std::{path::{Path,PathBuf},sync::OnceLock,fs::{File,OpenOptions}};
+struct Identity { root: PathBuf, id: String, nonce: String, port: u16, _lock: File }
+static IDENTITY: OnceLock<Identity> = OnceLock::new();
+pub fn enabled() -> bool { true }
+pub fn path(relative: &str) -> PathBuf { IDENTITY.get().expect("managed identity must initialize first").root.join(relative) }
+pub fn port() -> u16 { IDENTITY.get().expect("managed identity").port }
+fn checked(p: &Path) -> Result<(),String> {
+ for item in p.ancestors() {
+  let meta=std::fs::symlink_metadata(item).map_err(|e|e.to_string())?;
+  #[cfg(windows)] { use std::os::windows::fs::MetadataExt; if meta.file_attributes() & 0x400 != 0 { return Err("Managed reparse point denied".into()) } }
+  if meta.file_type().is_symlink() { return Err("Managed linked path denied".into()) }
+ }
+ Ok(())
+}
+pub fn initialize() -> Result<(),String> {
+ if IDENTITY.get().is_some() { return Ok(()) }
+ let get=|key:&str|std::env::var(key).map_err(|_|format!("Managed Desktop requires {key}"));
+ let root=PathBuf::from(get("WR_INSTANCE_ROOT")?);let id=get("WR_INSTANCE_ID")?;let nonce=get("WR_LAUNCH_NONCE")?;
+ let port=get("WR_INSTANCE_PORT")?.parse::<u16>().map_err(|e|e.to_string())?;
+ if !root.is_absolute() || id.is_empty() || id.len()>64 || !id.bytes().all(|b|b.is_ascii_alphanumeric() || b"._-".contains(&b)) || nonce.len()!=64 || !nonce.bytes().all(|b|b.is_ascii_hexdigit()) || port<1024 || port==3080 {return Err("Invalid managed identity".into())}
