+    if let Some((port, token)) = parse_launch_token(line) {
+        if let Ok(mut map) = carrier_tokens().lock() {
+            if map.insert(port, token).is_none() {
+                log::info!("Carrier launch credential captured for port {port}");
+            }
+        }
+    }
