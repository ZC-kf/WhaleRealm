+/// 有每实例凭据时先用 token 换 cookie（核心的 `authorizeIndex`：`GET /?token=<正确
+/// token>` → 303 + `Set-Cookie`），再用该 cookie 重新请求根路径；未捕获凭据（旧核心无
+/// 门禁或凭据尚未打印）时退化为裸 `GET /`。
+pub(super) async fn authorized_root_get(
+    client: &reqwest::Client,
+    port: u16,
+    root: &str,
+) -> Result<reqwest::Response, reqwest::Error> {
+    if carrier_token(port).is_none() {
+        return client.get(root).send().await;
+    }
+    match carrier_cookie(port).await {
+        Some(cookie) => {
+            client
+                .get(root)
+                .header(reqwest::header::COOKIE, cookie)
+                .send()
+                .await
+        }
+        None => client.get(root).send().await,
+    }
+}
