+/* WhaleRealm Copyright (C) 2026 凛枫. SPDX-License-Identifier: GPL-3.0-or-later */
+import { app } from 'electron'
+import { lstatSync, realpathSync, writeFileSync, renameSync } from 'node:fs'
+import { isAbsolute, join, dirname } from 'node:path'
+const env = process.env
+function required(name: string): string { const value=env[name]; if(!value) throw new Error(`Managed Desktop requires ${name}`); return value }
+export const managedId=required('WR_INSTANCE_ID')
+export const managedRoot=required('WR_INSTANCE_ROOT')
+export const managedNonce=required('WR_LAUNCH_NONCE')
+export const managedPort=Number(required('WR_INSTANCE_PORT'))
+if (!/^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$/.test(managedId) || !/^[a-f0-9]{64}$/.test(managedNonce) || !Number.isSafeInteger(managedPort) || managedPort<1024 || managedPort>65535 || managedPort===3080 || !isAbsolute(managedRoot)) throw new Error('Invalid managed identity')
+for (const rel of ['', 'data/dsh-home','data/electron-user-data','workspace','logs','cache','cache/home','cache/app-data','cache/local-app-data','cache/temp']) {
+ const target=join(managedRoot,rel)
+ for(let p=target;;p=dirname(p)){if(lstatSync(p).isSymbolicLink())throw new Error('Linked managed path');if(dirname(p)===p)break}
+ if(realpathSync(target).toLowerCase()!==target.toLowerCase()) throw new Error('Noncanonical managed path')
+}
+for(const [key,rel] of Object.entries({DSH_HOME:'data/dsh-home',DSH_DESKTOP_USER_DATA:'data/electron-user-data',HOME:'cache/home',USERPROFILE:'cache/home',APPDATA:'cache/app-data',LOCALAPPDATA:'cache/local-app-data',TEMP:'cache/temp',TMP:'cache/temp'})) {
+ if(env[key]!==join(managedRoot,rel))throw new Error(`Invalid private ${key}`)
+}
+app.setPath('userData',join(managedRoot,'data/electron-user-data'))
+app.setPath('sessionData',join(managedRoot,'data/electron-user-data'))
+app.setPath('logs',join(managedRoot,'logs'))
+app.setPath('crashDumps',join(managedRoot,'cache','crashes'))
+app.setAppUserModelId(`com.whalerealm.official.${managedId}`)
+export function managedReady(url: string): void {
+ if(new URL(url).port!==String(managedPort))throw new Error('Managed host changed reserved port')
+ const file=join(managedRoot,'logs',`ready-${managedNonce}.json`)
+ writeFileSync(file+'.tmp',JSON.stringify({id:managedId,nonce:managedNonce,port:managedPort,url}))
+ renameSync(file+'.tmp',file)
+}
